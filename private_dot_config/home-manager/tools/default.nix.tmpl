{{ if eq .chezmoi.os "linux" -}}
{{   if or (eq .chezmoi.osRelease.id "nixos") ( eq .chezmoi.osRelease.id "fedora" ) -}}
# Default tools
{ config, pkgs, ... }:
let
  {{   if eq .chezmoi.osRelease.id "nixos" -}}
  pkgsUnstable = import <nixpkgs-unstable> {};
  {{-   else if eq .chezmoi.osRelease.id "fedora" -}}
  pkgsUnstable = import <nixpkgs> {};
  {{- end }}
in
{
  imports = [
{{-  if ne .chezmoi.username "root" }}
    ./gui.nix
{{- end }}
  ];

  home.packages = with pkgs; [
{{-   if eq .chezmoi.osRelease.id "nixos" }}
    vim
    wget
    git
    curl
    openssl
    chezmoi
    jq
    gnupg
    python3
    python314Packages.pip
{{- end }}
    btop
    nmap
    starship
    yq
    kubectl
    kubectx
    k9s
    pkgsUnstable.fluxcd
    kubernetes-helm
    sops
    restic
    fzf
    lsd
    bat
    delta
    tty-clock
    libxml2
  ];
}
{{   end -}}
{{ end -}}
